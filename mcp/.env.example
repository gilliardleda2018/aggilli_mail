# Configuração do MCP do Aggilli Mail. Crie com: ./mail.sh mcp-config (pede a senha da caixa sem mostrar).
# NUNCA coloque o mcp/.env no Git.

# Endereço público (precisa do DNS A apontando para a VM da Oracle)
MCP_DOMAIN=mcp-mail.aggillintelligence.com.br
MCP_PUBLIC_URL=https://mcp-mail.aggillintelligence.com.br

# Caixa usada pelo chat (só o administrador) e a senha dela no mailserver
MCP_MAIL_ADDRESS=contato@mail.aggillintelligence.com.br
MCP_MAIL_PASSWORD=
MCP_FROM_NAME=Aggilli Intelligence

# Senha digitada na tela "Autorizar acesso ao Aggilli Mail" ao conectar no chat (>= 16 caracteres)
MCP_ADMIN_PASSWORD=

# Limites de envio (além dos 200/dia da Oracle)
MCP_MAX_SENDS_PER_HOUR=10
MCP_MAX_SENDS_PER_DAY=50
MCP_MAX_RECIPIENTS=10
