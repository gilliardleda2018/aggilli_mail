# Configuração do docker-mailserver
# Referência completa: https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/

LOG_LEVEL=info
ONE_DIR=1
TZ=America/Sao_Paulo

# Só aceita relay de clientes autenticados (nunca vira open relay)
PERMIT_DOCKER=none
# Usuário autenticado só pode enviar como o próprio endereço (ou aliases dele)
SPOOF_PROTECTION=1

# TLS via Let's Encrypt (certificado em ./data/certs, gerado pelo serviço certbot)
SSL_TYPE=letsencrypt

# Anti-spam + assinatura DKIM + verificação SPF/DMARC, tudo pelo Rspamd
ENABLE_RSPAMD=1
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_AMAVIS=0
ENABLE_SPAMASSASSIN=0
RSPAMD_GREYLISTING=1
MOVE_SPAM_TO_JUNK=1

# Bloqueia IPs após tentativas de login falhas
ENABLE_FAIL2BAN=1

# Antivírus consome ~1 GB de RAM; ligue se a máquina aguentar
ENABLE_CLAMAV=0

# Protocolos
ENABLE_IMAP=1
ENABLE_POP3=0
ENABLE_MANAGESIEVE=1

# Limite de tamanho de mensagem (bytes): 25 MB
POSTFIX_MESSAGE_SIZE_LIMIT=26214400

# Saída pela VPS (preenchido por ./mail.sh vps-link). Vazio = envia direto desta máquina.
DEFAULT_RELAY_HOST=
