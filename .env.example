# Copie para .env e ajuste
# Domínio dos endereços de email (voce@DOMAIN)
DOMAIN=mail.exemplo.com.br
# Nome do servidor (hostname, certificado TLS, registro MX)
MAIL_HOST=mail.exemplo.com.br
# IP desta máquina no Tailscale (a VPS repassa as conexões para cá)
TAILSCALE_IP=100.x.y.z
# IP público de casa (saída dos emails; entra no SPF)
HOME_PUBLIC_IP=203.0.113.10
